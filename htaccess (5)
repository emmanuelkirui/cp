<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /cps/

    # Redirect from the root to /cps
    RewriteCond %{HTTP_HOST} ^creativepulse\.42web\.io$ [NC]
    RewriteCond %{REQUEST_URI} ^/$
    RewriteRule ^(.*)$ https://creativepulse.42web.io/cps/ [R=301,L]

    # ========================
    # HTTPS ENFORCEMENT (NO WWW)
    # ========================
    RewriteCond %{HTTP_HOST} !^localhost$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # Remove www if present
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # ========================
    # CORE URL REWRITES
    # ========================
    # XML handlers
    # Redirect /page.php → /page (excludes allowed PHP files)
RewriteCond %{THE_REQUEST} \s/(?!rss\.php|sitemap\.xml\.php|auth\.php|acc_settings\.php|data-request\.php|analytics\.php)[^/]+\.php[\s?] [NC]
RewriteRule ^ /cps/%1 [R=301,L,NE]

# Block direct PHP access (excludes allowed PHP files)
RewriteCond %{THE_REQUEST} \s/(?!rss\.php|sitemap\.xml\.php|auth\.php|acc_settings\.php|data-request\.php|analytics\.php)[^/]+\.php[\s?] [NC]
RewriteRule ^ - [F,L]

    # --- Skip rewriting for real files and directories ---
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Remove trailing slashes (but not root)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]

    # Remove .php extension — serve clean URLs
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.+?)/?$ $1.php [L]

    # ========================
    # PERFORMANCE REWRITES
    # ========================
    # Cache busting for assets
    RewriteRule ^(.+)\.(\d+)\.(js|css|png|jpg|jpeg|gif|webp|svg)$ $1.$3 [L]

    # Serve pre-compressed files
    RewriteCond %{HTTP:Accept-Encoding} gzip
    RewriteCond %{REQUEST_FILENAME}\.gz -f
    RewriteRule ^(.*\.(js|css))$ $1.gz [L]

    # ========================
    # SECURITY REWRITES
    # ========================
    # Block direct PHP access (except rss.php and sitemap.xml.php)
RewriteCond %{THE_REQUEST} \s/(?!rss\.php|sitemap\.xml\.php|auth\.php|acc_settings\.php|data-request\.php|analytics\.php)[^/]+\.php[\s?] [NC]
    RewriteRule ^ - [F,L]

    # Block common exploits
    RewriteCond %{QUERY_STRING} (\<|%3C).*script.*(\>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} base64_encode.*\(.*\) [OR]
    RewriteCond %{QUERY_STRING} (\<|%3C).*iframe.*(\>|%3E) [NC,OR]
    RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
    RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2})
    RewriteRule .* - [F,L]
</IfModule>

# ========================
# BROWSER CACHING
# ========================
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresDefault "access plus 1 month"
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType application/x-javascript "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    ExpiresByType audio/mpeg "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/json "access plus 0 seconds"
    ExpiresByType application/xml "access plus 0 seconds"
</IfModule>

# ========================
# COMPRESSION
# ========================
<IfModule mod_deflate.c>
    <IfModule mod_setenvif.c>
        <IfModule mod_headers.c>
            SetEnvIfNoCase ^(Accept-EncodXng|X-cept-Encoding|X{15}|~{15}|-{15})$ ^((gzip|deflate)\s*,?\s*)+|[X~-]{4,13}$ HAVE_Accept-Encoding
            RequestHeader append Accept-Encoding "gzip,deflate" env=HAVE_Accept-Encoding
        </IfModule>
    </IfModule>

    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
    AddOutputFilterByType DEFLATE application/x-font-ttf application/x-font-opentype font/opentype font/ttf
    AddOutputFilterByType DEFLATE image/svg+xml

    <FilesMatch "\.(js|css)\.gz$">
        AddType "text/javascript" .js.gz
        AddType "text/css" .css.gz
    </FilesMatch>
</IfModule>

# ========================
# BROTLI COMPRESSION
# ========================
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS application/x-font-ttf application/x-font-opentype font/opentype font/ttf
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ========================
# HTTP/2 OPTIMIZATIONS
# ========================
<IfModule mod_headers.c>
    Header add Link "</assets/css/main.css>; rel=preload; as=style"
    Header add Link "</assets/js/main.js>; rel=preload; as=script"
    Header add Link "</assets/fonts/primary.woff2>; rel=preload; as=font; type=font/woff2; crossorigin"
    Header add Link "</assets/images/hero.webp>; rel=preload; as=image; type=image/webp"
    Header add Link "</assets/css/critical.css>; rel=preload; as=style"
    Header add Link "<https://fonts.gstatic.com>; rel=dns-prefetch"
    Header add Link "<https://www.google.com>; rel=dns-prefetch"
    Header add Link "<https://fonts.googleapis.com>; rel=preconnect"
    Header add Link "<https://fonts.gstatic.com>; rel=preconnect; crossorigin"
    Header set Connection keep-alive
    Header set Server-Timing "cdn;desc=\"CDN Cache\";dur=50"
</IfModule>

# ========================
# CORS — Allow GitHub Pages to fetch this site silently
# ========================
<IfModule mod_headers.c>
    SetEnvIf Origin "^https://emmanuelkirui\.github\.io$" GITHUB_ORIGIN=1
    Header always set Access-Control-Allow-Origin "https://emmanuelkirui.github.io" env=GITHUB_ORIGIN
    Header always set Access-Control-Allow-Methods "GET, OPTIONS" env=GITHUB_ORIGIN
    Header always set Access-Control-Allow-Headers "Content-Type" env=GITHUB_ORIGIN
    Header always set Access-Control-Max-Age "86400" env=GITHUB_ORIGIN
</IfModule>

# Handle OPTIONS preflight from GitHub Pages
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteCond %{HTTP_ORIGIN} ^https://emmanuelkirui\.github\.io$ [NC]
    RewriteRule .* - [R=204,L]
</IfModule>

# ========================
# SECURITY HEADERS
# ========================
<IfModule mod_headers.c>
    # X-Frame-Options: exempt GitHub Pages, keep SAMEORIGIN for everyone else
    SetEnvIf Origin "^https://emmanuelkirui\.github\.io$" GITHUB_ORIGIN=1
    Header always set X-Frame-Options "SAMEORIGIN" env=!GITHUB_ORIGIN
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" env=HTTPS

    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https: https://cdn.credly.com https://www.google.com https://www.gstatic.com https://www.paypal.com https://www.sandbox.paypal.com https://www.paypalobjects.com; style-src 'self' 'unsafe-inline' https: https://www.google.com https://fonts.googleapis.com https://www.paypal.com https://www.sandbox.paypal.com https://www.paypalobjects.com; img-src 'self' data: https: https://www.credly.com https://images.credly.com https://www.google.com https://www.gstatic.com https://www.paypal.com https://www.sandbox.paypal.com https://www.paypalobjects.com; font-src 'self' https: https://fonts.gstatic.com; connect-src 'self' https: https://www.paypal.com https://www.sandbox.paypal.com https://www.paypalobjects.com; media-src 'self' https:; object-src 'none'; frame-src https://www.google.com https://www.paypal.com https://www.sandbox.paypal.com https://www.credly.com; frame-ancestors 'self' https://emmanuelkirui.github.io; form-action 'self' https://www.paypal.com https://www.sandbox.paypal.com;"

    Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), fullscreen=()"
    Header set Feature-Policy "geolocation 'none'; microphone 'none'; camera 'none'; payment 'none'; fullscreen 'self'"
    Header always set Cache-Control "private,max-age=86400, must-revalidate"
</IfModule>

# ── Hide server identity ─────────────────────────────────────────────────────
ServerSignature Off
Header unset Server
Header unset X-Powered-By

# ========================
# FILE PROTECTIONS
# ========================
<FilesMatch "\.(htaccess|htpasswd|env|ini|log|sh|sql|bak|swp|conf)$">
    Require all denied
</FilesMatch>

<Files ~ "^\.(env|git|gitignore|gitattributes)">
    Require all denied
</Files>

# ========================
# PHP PERFORMANCE & SESSION SETTINGS (24 HOURS)
# ========================
<IfModule mod_php.c>
    php_value upload_max_filesize 50M
    php_value post_max_size 50M
    php_value memory_limit 256M
    php_value max_execution_time 180
    php_value max_input_time 180
    php_flag zlib.output_compression On
    php_value zlib.output_compression_level 5
    php_value session.gc_maxlifetime 86400
    php_value session.cookie_lifetime 86400
    php_value session.cookie_path "/"
    php_value session.cache_limiter "nocache"
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log "/var/log/php_errors.log"
</IfModule>

<FilesMatch "\.(json|txt|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "^config\.json$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ========================
# MISC OPTIMIZATIONS
# ========================
Options -Indexes
Options -MultiViews
FileETag None

# Error Documents
ErrorDocument 400 /cps/error?code=400
ErrorDocument 401 /cps/error?code=401
ErrorDocument 403 /cps/error?code=403
ErrorDocument 404 /cps/error?code=404
ErrorDocument 413 /cps/error?code=413
ErrorDocument 500 /cps/error?code=500
ErrorDocument 503 /cps/error?code=503
ErrorDocument 508 /cps/error?code=508

# ========================
# MEDIA TYPES
# ========================
AddType image/webp .webp
AddType image/avif .avif
AddType video/mp4 .mp4
AddType video/webm .webm
AddType audio/mpeg .mp3
AddType audio/ogg .ogg
AddType font/woff2 .woff2

# ========================
# BOT PROTECTION
# ========================
<IfModule mod_rewrite.c>
    # Whitelist: GitHub Pages browser fetch (Origin header present) and GitHub Actions
    RewriteCond %{HTTP_ORIGIN} ^https://emmanuelkirui\.github\.io$ [NC,OR]
    RewriteCond %{HTTP_REFERER} ^https://emmanuelkirui\.github\.io [NC]
    RewriteRule .* - [L]

    # Block bad bots (curl/wget excluded when coming from GitHub above)
    RewriteCond %{HTTP_USER_AGENT} !(Googlebot|Bingbot) [NC]
    RewriteCond %{HTTP_USER_AGENT} (AhrefsBot|Baiduspider|CCBot|DotBot|MJ12bot|SemrushBot|YandexBot|ZoominfoBot) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (libwww-perl|wget|python|nikto|curl|scan|java|winhttp|clshttp|loader) [NC,OR]
    RewriteCond %{HTTP_USER_AGENT} (<|>|'|%0A|%0D|%27|%3C|%3E|%00) [NC]
    RewriteRule .* - [F,L]
</IfModule>